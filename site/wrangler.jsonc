// Cloudflare Workers static assets for https://datasafety.sanikant.dev (see DEPLOY.md).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "data-safety-from-code-docs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "datasafety.sanikant.dev", "custom_domain": true }]
}
