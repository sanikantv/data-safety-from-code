---
// Install commands for each agent, generated from src/lib/site.ts.
import { Code, TabItem, Tabs } from '@astrojs/starlight/components';
import { MARKETPLACE, REPO, REPO_SLUG, SKILL } from '../lib/site';

const session = `/plugin marketplace add ${REPO_SLUG}\n/plugin install ${SKILL}@${MARKETPLACE}`;
const shell = `claude plugin marketplace add ${REPO_SLUG}\nclaude plugin install ${SKILL}@${MARKETPLACE}`;
const npx = `npx --yes skills add ${REPO_SLUG} --skill ${SKILL} -y`;
const manual = `git clone ${REPO}.git\ncp -r data-safety-from-code/skills/${SKILL} ~/.claude/skills/`;
---

<Tabs syncKey="install">
  <TabItem label="Claude Code">
    <Code code={session} lang="text" title="Inside a Claude Code session" />
    <Code code={shell} lang="bash" title="Or from your shell" />
  </TabItem>
  <TabItem label="Codex · Cursor · Copilot">
    <Code code={npx} lang="bash" title="skills CLI (works with most agents)" />
  </TabItem>
  <TabItem label="Copy the folder">
    <Code code={manual} lang="bash" title="Personal skill (or copy into your project's .claude/skills/)" />
  </TabItem>
</Tabs>
