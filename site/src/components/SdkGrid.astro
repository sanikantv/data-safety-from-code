---
// Cards for the SDK pages, from src/data/sdks.json (generated by scripts/gen-pages.mjs).
import Icon from './Icon.astro';
import sdks from '../data/sdks.json';

interface Props {
  limit?: number;
}
const { limit } = Astro.props;
const ICON: Record<string, string> = {
  ads: 'campaign', analytics: 'monitoring', crash: 'bug_report', auth: 'key', database: 'database',
  messaging: 'notifications', payments: 'payments', ml: 'center_focus_strong', ai: 'auto_awesome', other: 'extension',
};
const list = limit ? sdks.filter((s) => s.confidence === 'official').slice(0, limit) : sdks;
---

<div class="sdk-grid not-content">
  {
    list.map((s) => (
      <a class="sdk-card" href={`/sdk/${s.id}/`}>
        <span class="sdk-icon">
          <Icon name={ICON[s.category] ?? 'extension'} size={22} />
        </span>
        <strong>{s.name}</strong>
        <span class="sdk-types">{s.types.length ? s.types.join(', ') : 'Depends on how you use it'}</span>
        <span class="sdk-meta">
          {s.shares ? 'Collected + shared' : 'Collected'}
          {s.confidence !== 'official' && ' · inferred'}
        </span>
      </a>
    ))
  }
</div>

<style>
  .sdk-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 0.75rem;
    margin: 1.25rem 0;
  }
  .sdk-card {
    display: grid;
    gap: 0.35rem;
    align-content: start;
    padding: 1rem 1.1rem;
    border-radius: var(--md-shape-lg);
    background: var(--md-surface-container);
    color: var(--md-on-surface);
    text-decoration: none;
    transition: border-radius var(--md-spring-expressive-fast-spatial-ms) var(--md-spring-expressive-fast-spatial),
      background-color var(--md-spring-default-effects-ms) var(--md-spring-default-effects);
  }
  .sdk-card:hover {
    background: var(--md-surface-container-high);
    border-radius: var(--md-shape-xl);
  }
  .sdk-icon {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    margin-bottom: 0.3rem;
    border-radius: var(--md-shape-md);
    background: var(--md-primary-container);
    color: var(--md-on-primary-container);
  }
  .sdk-types {
    font-size: 0.85rem;
    color: var(--md-on-surface-variant);
  }
  .sdk-meta {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--md-primary);
  }
</style>
