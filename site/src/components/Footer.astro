---
// Starlight's footer (edit link, last updated, pagination) plus project links.
import Default from '@astrojs/starlight/components/Footer.astro';
import { HUB, REPO } from '../lib/site';
---

<Default />
<nav class="site-footer" aria-label="Project links">
  <a href={`${REPO}/blob/main/LICENSE`}>MIT license</a>
  <a href={REPO}>GitHub</a>
  <a href="/changelog/">Changelog</a>
  <a href="https://expressive.sanikant.dev/">M3 Expressive Skill</a>
  <a href={HUB}>More from sanikant.dev</a>
</nav>
<p class="site-credit">
  Built by <a href={HUB}>Sanikant</a>. Set in Google Sans Flex (SIL Open Font License), icons from Material Symbols
  (Apache 2.0). Google Play is a trademark of Google LLC; this project is not affiliated with Google. Output is a
  draft for review: you are responsible for your Data safety declaration.
</p>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--md-outline-variant);
    font-size: var(--sl-text-sm);
  }
  .site-footer a,
  .site-credit a {
    color: var(--md-on-surface-variant);
  }
  .site-credit {
    font-size: var(--sl-text-xs);
    color: var(--md-on-surface-variant);
    margin-top: 0.5rem;
  }
</style>
