---
// Starlight's title, with visible breadcrumbs on inner pages (they mirror the BreadcrumbList JSON-LD).
// The home page renders its own H1 in Hero.astro.
import Default from '@astrojs/starlight/components/PageTitle.astro';

const { id, entry } = Astro.locals.starlightRoute;
const sections: Record<string, string> = { sdk: 'SDKs', reference: 'Reference', guides: 'Guides' };
const section = id.split('/')[0];
const isIndex = id === section;
const crumbs = [{ label: 'Home', href: '/' }];
if (sections[section] && !isIndex) crumbs.push({ label: sections[section], href: `/${section}/` });
---

{
  id !== '' && id !== 'index' && (
    <nav aria-label="Breadcrumb" class="crumbs">
      <ol>
        {crumbs.map((c) => (
          <li>
            <a href={c.href}>{c.label}</a>
          </li>
        ))}
        <li aria-current="page">{entry.data.title}</li>
      </ol>
    </nav>
  )
}
{id !== '' && id !== 'index' && <Default />}

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--md-on-surface-variant);
  }
  .crumbs li + li::before {
    content: '/';
    margin-inline-end: 0.5rem;
    color: var(--sl-color-gray-4);
  }
  .crumbs a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--md-primary);
  }
</style>
